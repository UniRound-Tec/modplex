# File path: /etc/systemd/system/modplex.service
# sudo systemctl daemon-reload
# sudo systemctl start modplex
# sudo systemctl enable modplex
# sudo systemctl status modplex
[Unit]
Description=One API Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/modplex  # 注意修改路径
ExecStart=/path/to/modplex/modplex --port 3000 --log-dir /path/to/modplex/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
